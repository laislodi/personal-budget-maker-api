# SQLite (default, zero-config for development)
DATABASE_URL=sqlite+aiosqlite:///./budget.db

# PostgreSQL (switch to this for production)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/budget_db

SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
