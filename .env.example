# --- Database ---

# SQLite (default, zero-config for local dev — no Docker needed)
DATABASE_URL=sqlite+aiosqlite:///./budget.db

# PostgreSQL via Docker Compose — fill these in, then swap DATABASE_URL below
# POSTGRES_USER=budget
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=budget_db
# DATABASE_URL=postgresql+asyncpg://budget:change-me@localhost:5432/budget_db

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://laislodi.github.io
